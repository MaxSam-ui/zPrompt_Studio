{
  "schema_version": 1,
  "adapter": "zimage",
  "capabilities": {
    "text_to_image": true,
    "image_to_image": true,
    "edit": false,
    "text_to_video": false,
    "image_to_video": false,
    "first_last_frames": false,
    "middle_image": false,
    "custom_lora": true
  },
  "nodes": {
    "model": {
      "id": "1",
      "slot": "1",
      "class_type": "UNETLoader",
      "required_inputs": [
        "unet_name",
        "weight_dtype"
      ]
    },
    "text_encoder": {
      "id": "2",
      "slot": "2",
      "class_type": "CLIPLoaderGGUF",
      "required_inputs": [
        "clip_name",
        "type"
      ]
    },
    "vae": {
      "id": "3",
      "slot": "3",
      "class_type": "VAELoader",
      "required_inputs": [
        "vae_name"
      ]
    },
    "latent": {
      "id": "4",
      "slot": "4",
      "class_type": "EmptySD3LatentImage",
      "required_inputs": [
        "width",
        "height",
        "batch_size"
      ]
    },
    "prompt": {
      "id": "5",
      "slot": "5",
      "class_type": "CLIPTextEncode",
      "required_inputs": [
        "text",
        "clip"
      ]
    },
    "negative": {
      "id": "6",
      "slot": "6",
      "class_type": "ConditioningZeroOut",
      "required_inputs": [
        "conditioning"
      ]
    },
    "sampling": {
      "id": "7",
      "slot": "7",
      "class_type": "KSampler",
      "required_inputs": [
        "seed",
        "steps",
        "cfg",
        "sampler_name",
        "scheduler",
        "denoise",
        "model",
        "positive",
        "negative",
        "latent_image"
      ]
    },
    "decode": {
      "id": "8",
      "slot": "8",
      "class_type": "VAEDecode",
      "required_inputs": [
        "samples",
        "vae"
      ]
    },
    "output": {
      "id": "9",
      "slot": "9",
      "class_type": "SaveImage",
      "required_inputs": [
        "filename_prefix",
        "images"
      ]
    },
    "modelsamplingauraflow_10": {
      "id": "10",
      "slot": "10",
      "class_type": "ModelSamplingAuraFlow",
      "required_inputs": [
        "shift",
        "model"
      ]
    },
    "latentupscaleby_11": {
      "id": "11",
      "slot": "11",
      "class_type": "LatentUpscaleBy",
      "required_inputs": [
        "upscale_method",
        "scale_by",
        "samples"
      ]
    },
    "ksampler_12": {
      "id": "12",
      "slot": "12",
      "class_type": "KSampler",
      "required_inputs": [
        "seed",
        "steps",
        "cfg",
        "sampler_name",
        "scheduler",
        "denoise",
        "model",
        "positive",
        "negative",
        "latent_image"
      ]
    },
    "loraloadermodelonly_15": {
      "id": "15",
      "slot": "15",
      "class_type": "LoraLoaderModelOnly",
      "required_inputs": [
        "lora_name",
        "strength_model",
        "model"
      ]
    },
    "loraloadermodelonly_16": {
      "id": "16",
      "slot": "16",
      "class_type": "LoraLoaderModelOnly",
      "required_inputs": [
        "lora_name",
        "strength_model",
        "model"
      ]
    },
    "loraloadermodelonly_17": {
      "id": "17",
      "slot": "17",
      "class_type": "LoraLoaderModelOnly",
      "required_inputs": [
        "lora_name",
        "strength_model",
        "model"
      ]
    }
  }
}
